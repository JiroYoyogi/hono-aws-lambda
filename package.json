    "@hono/aws-lambda": "^1.0.2",
    "@hono/node-server": "^2.1.11",
    "@hono/zod-validator": "^0.9.1",
    "hono": "^4.13.19",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
