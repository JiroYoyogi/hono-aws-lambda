  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run build:lambda",
    "build:lambda": "node --env-file=.env scripts/build-lambda.mjs",
